<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>01189e6e-61cb-4c5d-acf7-1ba0a2c819ab</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>StarQ.Shared</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)**\*.cs" Exclude="$(MSBuildThisFileDirectory)Projects\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)LICENSE.txt" />
    <Content Include="$(MSBuildThisFileDirectory)**\*.json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)Executables\*" />
    <None Include="$(MSBuildThisFileDirectory)Files\*" />
    <None Include="$(MSBuildThisFileDirectory)LicenseNotes.md" />
    <None Include="$(MSBuildThisFileDirectory)Locale\LocaleMaker.py" />
    <None Include="$(MSBuildThisFileDirectory)LocaleMaker.py" />
    <None Include="$(MSBuildThisFileDirectory)README.md" />
    <None Include="$(MSBuildThisFileDirectory)StarQ.Shared.props" />
    <None Include="$(MSBuildThisFileDirectory)StarQ.Shared.targets" />
    <None Include="$(MSBuildThisFileDirectory)Targets\*" />
  </ItemGroup>
</Project>