<Project>
  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <GameVersion>1.6.4*</GameVersion>
    <Authors>StarQ</Authors>
    <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
    <CrowdinSync>false</CrowdinSync>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="Properties\*.md" />
    <ProjectReference
      Include="$(CS2_STARQ_SHARED_PATH)\Projects\StarQ.Shared.Generators\StarQ.Shared.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.28.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
    <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System">
      <Private>false</Private>
    </Reference>
    <Reference Update="System.Core">
      <Private>false</Private>
    </Reference>
    <Reference Update="System.Data">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
